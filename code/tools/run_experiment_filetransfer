# ---------------------------------------------------------------------------
# General utilities
# ---------------------------------------------------------------------------

def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def read_text(path: str | pathlib.Path) -> str | None:
    try:
        return pathlib.Path(path).read_text(errors="replace")
    except OSError:
        return None


def read_json_lines(path: pathlib.Path) -> list[dict[str, Any]]:
    """Read valid JSON objects from a JSONL file, ignoring incomplete lines."""
    if not path.exists():
        return []

    records: list[dict[str, Any]] = []

    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return []

    for line in lines:
        try:
            value = json.loads(line)
        except json.JSONDecodeError:
            continue

        if isinstance(value, dict):
            records.append(value)

    return records


def latest_stats(path: pathlib.Path) -> dict[str, Any] | None:
    records = read_json_lines(path)
    return records[-1] if records else None


def stats_delta(
    before: dict[str, Any] | None,
    after: dict[str, Any] | None,
) -> dict[str, int] | None:
    """Calculate counter deltas, rejecting missing or decreasing counters."""
    if before is None or after is None:
        return None

    before_stats = before.get("stats")
    after_stats = after.get("stats")

    if not isinstance(before_stats, dict) or not isinstance(after_stats, dict):
        return None

    delta: dict[str, int] = {}

    for key, after_value in after_stats.items():
        if not isinstance(after_value, (int, float)):
            continue

        before_value = before_stats.get(key)

        if not isinstance(before_value, (int, float)):
            return None

        difference = int(after_value) - int(before_value)

        # Counter rollback means the snapshots cannot safely be compared.
        if difference < 0:
            return None

        delta[key] = difference

    if not delta:
        return None

    return delta


def render_args(
    command: list[Any],
    values: dict[str, Any],
) -> list[str]:
    """Substitute placeholders in an argument array without invoking a shell."""
    rendered: list[str] = []

    for part in command:
        try:
            rendered.append(str(part).format_map(values))
        except (KeyError, ValueError) as exc:
            raise ValueError(
                f"could not substitute command argument {part!r}: {exc}"
            ) from exc

    return rendered


def run_command(
    command: list[Any],
    values: dict[str, Any],
    timeout: float | None,
    output_path: pathlib.Path,
) -> subprocess.CompletedProcess[bytes]:
    argv = render_args(command, values)

    if not argv:
        raise ValueError("command arrays must not be empty")

    with output_path.open("wb") as output:
        return subprocess.run(
            argv,
            stdout=output,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
        )


def safe_component(text: str) -> str:
    return (
        "".join(
            character
            if character.isalnum() or character in "._-"
            else "_"
            for character in text
        )
        or "run"
    )


def config_label(config: dict[str, Any]) -> str:
    flags = (
        "baseline"
        if not config.get("flags")
        else "_".join(map(str, config["flags"]))
    )

    dimensions = (
        config.get("server", ""),
        config.get("mechanism", ""),
        flags,
        config.get("workload", ""),
        f"connections{config.get('connections', '')}",
        f"msg{config.get('message_size', '')}",
        f"rate{config.get('offered_rate', 'none')}",
        f"delay{config.get('delay', 'none')}",
    )

    return "-".join(
        safe_component(str(value))
        for value in dimensions
    )


# ---------------------------------------------------------------------------
# Environment and host-state collection
# ---------------------------------------------------------------------------

def cpu_stat(cpu: int) -> str | None:
    data = read_text("/proc/stat")

    if data is None:
        return None

    label = f"cpu{cpu} "

    return next(
        (
            line
            for line in data.splitlines()
            if line.startswith(label)
        ),
        None,
    )


def host_health(config: dict[str, Any]) -> dict[str, Any]:
    cpus: list[int] = []

    for key in ("server_cpu", "interrupt_cpu"):
        value = config.get(key)

        if value is not None and int(value) not in cpus:
            cpus.append(int(value))

    frequencies: dict[str, str | None] = {}

    for cpu in cpus:
        frequencies[str(cpu)] = read_text(
            f"/sys/devices/system/cpu/cpu{cpu}/cpufreq/scaling_cur_freq"
        )

    thermal: dict[str, str | None] = {}

    for path in pathlib.Path("/sys/class/thermal").glob(
        "thermal_zone*/temp"
    ):
        thermal[str(path)] = read_text(path)

    return {
        "cpu_frequency_khz": frequencies,
        "thermal_zone_values": thermal,
    }


def environment(config: dict[str, Any]) -> dict[str, Any]:
    env: dict[str, Any] = {
        "captured_utc": utc_now(),
        "kernel": platform.release(),
        "platform": platform.platform(),
        "python": sys.version,
        "cpuinfo": read_text("/proc/cpuinfo"),
        "meminfo": read_text("/proc/meminfo"),
        "sysctls": {},
        "limits": {},
        "cgroup_cpu_stat": None,
        "client_cpu_stat": None,
        "server_cpu_stat": None,
        "interrupt_cpu_stat": None,
        "cpu_governor": None,
        "unavailable": [],
    }

    sysctl_names = (
        "kernel.io_uring_disabled",
        "kernel.perf_event_paranoid",
        "net.core.somaxconn",
        "net.ipv4.ip_local_port_range",
        "net.ipv4.tcp_tw_reuse",
    )

    for name in sysctl_names:
        proc_path = pathlib.Path("/proc/sys") / pathlib.Path(
            name.replace(".", "/")
        )
        value = read_text(proc_path)

        env["sysctls"][name] = (
            value.strip() if value is not None else None
        )

    try:
        env["limits"]["nofile"] = list(
            resource.getrlimit(resource.RLIMIT_NOFILE)
        )
        env["limits"]["memlock"] = list(
            resource.getrlimit(resource.RLIMIT_MEMLOCK)
        )
    except (OSError, ValueError):
        env["unavailable"].append("process resource limits")

    if config.get("cgroup_cpu_stat"):
        env["cgroup_cpu_stat"] = read_text(
            config["cgroup_cpu_stat"]
        )

    if config.get("client_cpu_stat"):
        env["client_cpu_stat"] = read_text(
            config["client_cpu_stat"]
        )

    if config.get("server_cpu") is not None:
        env["server_cpu_stat"] = cpu_stat(
            int(config["server_cpu"])
        )

        env["cpu_governor"] = read_text(
            f"/sys/devices/system/cpu/cpu"
            f"{int(config['server_cpu'])}/cpufreq/scaling_governor"
        )

    if config.get("interrupt_cpu") is not None:
        env["interrupt_cpu_stat"] = cpu_stat(
            int(config["interrupt_cpu"])
        )

    commands = [
        ["uname", "-a"],
        ["lscpu"],
        ["ip", "-br", "link"],
        [
            "sysctl",
            "kernel.io_uring_disabled",
            "kernel.perf_event_paranoid",
            "net.core.somaxconn",
            "net.ipv4.ip_local_port_range",
            "net.ipv4.tcp_tw_reuse",
        ],
    ]

    interface = config.get("nic_interface")

    if interface:
        commands.extend(
            [
                ["ethtool", str(interface)],
                ["ethtool", "-k", str(interface)],
                ["ethtool", "-c", str(interface)],
            ]
        )

    for argv in commands:
        command_name = " ".join(argv)

        try:
            completed = subprocess.run(
                argv,
                capture_output=True,
                text=True,
                timeout=10,
                check=False,
            )

            env.setdefault("host_commands", {})[command_name] = (
                completed.stdout
                if completed.returncode == 0
                else completed.stderr
            )
        except (OSError, subprocess.SubprocessError) as exc:
            env.setdefault("host_commands", {})[command_name] = (
                f"unavailable: {exc}"
            )

    try:
        completed = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
            check=True,
            timeout=5,
        )

        env["git_commit"] = completed.stdout.strip()

    except (OSError, subprocess.SubprocessError):
        env["git_commit"] = None
        env["unavailable"].append("git commit hash")

    return env


# ---------------------------------------------------------------------------
# Server lifecycle
# ---------------------------------------------------------------------------

def wait_for_server_ready(
    server: subprocess.Popen[bytes],
    port: int,
    timeout: float = 10.0,
) -> None:
    """Wait for the server to accept TCP connections on localhost."""
    deadline = time.monotonic() + timeout
    last_error = "no connection attempt made"

    while time.monotonic() < deadline:
        if server.poll() is not None:
            raise RuntimeError(
                "server exited before becoming ready "
                f"(status {server.returncode})"
            )

        try:
            with socket.create_connection(
                ("127.0.0.1", port),
                timeout=0.25,
            ):
                return

        except OSError as exc:
            last_error = str(exc)
            time.sleep(0.1)

    raise TimeoutError(
        f"server did not become ready on 127.0.0.1:{port} "
        f"within {timeout:g}s; last error: {last_error}"
    )


def stop_process(
    process: subprocess.Popen[bytes] | None,
    timeout: float = 5.0,
) -> None:
    """Stop a process and its process group, escalating if necessary."""
    if process is None:
        return

    if process.poll() is not None:
        return

    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except OSError:
        try:
            process.terminate()
        except OSError:
            pass

    try:
        process.wait(timeout=timeout)
        return
    except subprocess.TimeoutExpired:
        pass

    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except OSError:
        try:
            process.kill()
        except OSError:
            pass

    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass


def ensure_stats_file_argument(
    command: list[str],
    stats_file: str,
) -> list[str]:
    """Add --stats-file unless the command already specifies it."""
    has_stats_argument = any(
        arg == "--stats-file"
        or arg.startswith("--stats-file=")
        for arg in command
    )

    if not has_stats_argument:
        command.extend(["--stats-file", stats_file])

    return command


# ---------------------------------------------------------------------------
# Client validation
# ---------------------------------------------------------------------------

def validate_client_output(
    path: pathlib.Path,
    client_validator: str | None,
) -> tuple[bool, str]:
    """Validate measured client output instead of trusting exit status alone."""
    if client_validator is None:
        return True, "no client-output validator configured"

    try:
        output = path.read_text(errors="replace")
    except OSError as exc:
        return False, f"cannot read client output: {exc}"

    if client_validator == "wrk":
        # A successful exit code alone does not prove that wrk completed
        # a meaningful HTTP measurement.
        summary_pattern = re.compile(
            r"^\s*[\d,]+\s+requests in\s+\S+",
            re.MULTILINE,
        )
        rate_pattern = re.compile(
            r"^\s*Requests/sec:\s*([\d.]+)",
            re.MULTILINE,
        )

        summary_match = summary_pattern.search(output)
        rate_match = rate_pattern.search(output)

        if not summary_match:
            return False, (
                "wrk output is missing its completed request summary"
            )

        if not rate_match:
            return False, "wrk output is missing Requests/sec"

        try:
            request_rate = float(rate_match.group(1))
        except ValueError:
            return False, "could not parse wrk Requests/sec"

        if request_rate <= 0:
            return False, "wrk reported a non-positive request rate"

        request_summary = summary_match.group(0)
        request_count_match = re.match(
            r"\s*([\d,]+)",
            request_summary,
        )

        if not request_count_match:
            return False, "could not parse wrk completed request count"

        completed_requests = int(
            request_count_match.group(1).replace(",", "")
        )

        if completed_requests <= 0:
            return False, "wrk completed zero requests"

        for line in output.splitlines():
            if "Non-2xx or 3xx responses:" in line:
                try:
                    failures = int(
                        line.rsplit(":", 1)[1].strip().replace(",", "")
                    )
                except ValueError:
                    return False, (
                        f"could not parse wrk response summary: {line}"
                    )

                if failures > 0:
                    return False, (
                        f"wrk reported {failures} non-2xx/3xx responses"
                    )

            if "Socket errors:" in line:
                details = line.split(":", 1)[1]
                numbers = re.findall(r"\d+", details)

                if not numbers:
                    return False, (
                        f"could not parse wrk socket errors: {details.strip()}"
                    )

                if any(int(value) > 0 for value in numbers):
                    return False, (
                        f"wrk reported socket errors: {details.strip()}"
                    )

        return True, (
            f"wrk completed {completed_requests} requests; "
            f"Requests/sec={request_rate:g}; "
            "no reported HTTP or socket errors"
        )

    raise ValueError(
        f"unknown client_validator: {client_validator}"
    )


# ---------------------------------------------------------------------------
# Snapshots and acceptance checks
# ---------------------------------------------------------------------------

def wait_for_accepts(
    server: subprocess.Popen[bytes],
    stats_path: pathlib.Path,
    connections: int,
    accepted_before: int = 0,
    timeout: float = 60.0,
) -> dict[str, Any] | None:
    """Wait for the requested number of new server accepts."""
    deadline = time.monotonic() + timeout

    while time.monotonic() < deadline:
        if server.poll() is not None:
            raise RuntimeError(
                "server exited while waiting for client connections "
                f"(status {server.returncode})"
            )

        try:
            server.send_signal(signal.SIGUSR1)
        except ProcessLookupError as exc:
            raise RuntimeError(
                "server exited while waiting for client acceptance"
            ) from exc

        time.sleep(0.2)

        latest = latest_stats(stats_path)

        if latest is None:
            continue

        stats = latest.get("stats", {})
        accepts = stats.get("accepts")

        if not isinstance(accepts, (int, float)):
            continue

        if int(accepts) >= accepted_before + connections:
            return latest

    raise TimeoutError(
        f"server did not accept {connections} new connections "
        f"within {timeout:g}s"
    )


def snapshot(
    server: subprocess.Popen[bytes],
    stats_path: pathlib.Path,
    cpu_file: str | None,
    client_cpu_file: str | None,
    cpu: int | None,
    interrupt_cpu: int | None,
) -> dict[str, Any]:
    """Request a server snapshot and collect available host counters."""
    try:
        server.send_signal(signal.SIGUSR1)
    except ProcessLookupError:
        pass

    # The server writes its stats asynchronously from the signal handler.
    time.sleep(0.25)

    return {
        "captured_utc": utc_now(),
        "server_stats": latest_stats(stats_path),
        "cgroup_cpu_stat": (
            read_text(cpu_file) if cpu_file else None
        ),
        "client_cpu_stat": (
            read_text(client_cpu_file) if client_cpu_file else None
        ),
        "cpu_stat": cpu_stat(int(cpu)) if cpu is not None else None,
        "interrupt_cpu_stat": (
            cpu_stat(int(interrupt_cpu))
            if interrupt_cpu is not None
            else None
        ),
        "health": host_health(
            {
                "server_cpu": cpu,
                "interrupt_cpu": interrupt_cpu,
            }
        ),
    }


def automated_acceptance(
    result: dict[str, Any],
    config: dict[str, Any],
) -> tuple[bool, list[str]]:
    """Apply the runner's explicit, machine-checkable acceptance criteria."""
    reasons: list[str] = []

    if result.get("warmup_exit") != 0:
        reasons.append("warm-up did not complete successfully")

    if result.get("measured_exit") != 0:
        reasons.append("measured client did not exit successfully")

    if result.get("client_output_ok") is not True:
        reasons.append("client output validation failed")

    if result.get("acceptance_ok") is not True:
        reasons.append("required client connections were not confirmed")

    delta = result.get("counter_delta")

    if not isinstance(delta, dict):
        reasons.append("server counter snapshots are unavailable")
    else:
        if "messages" not in delta:
            reasons.append("message counter is missing")

        if delta.get("errors", 0) != 0:
            reasons.append("server reported errors")

        if delta.get("ring_overflows", 0) != 0:
            reasons.append("server reported ring overflows")

        # Unexpected peer resets are not automatically interpreted as
        # failures: some workloads may legitimately close connections.
        # If the configured workload expects persistent connections,
        # the experiment plan must specify the appropriate reset policy.

    if result.get("measured_elapsed_seconds", 0) <= 0:
        reasons.append("invalid measured elapsed time")

    if config.get("client_validator") is None:
        reasons.append("no client-output validator was configured")

    if result.get("server_exit") not in (0, -signal.SIGTERM, None):
        # A server may be terminated deliberately after the measurement.
        # Other exit statuses need inspection.
        reasons.append(
            f"unexpected server exit status {result.get('server_exit')}"
        )

    return not reasons, reasons


# ---------------------------------------------------------------------------
# One complete repetition
# ---------------------------------------------------------------------------

def execute_repeat(
    config: dict[str, Any],
    repeat: int,
    run_dir: pathlib.Path,
    port: int,
) -> dict[str, Any]:
    """Execute one isolated repetition and always preserve its diagnostics."""
    run_dir.mkdir(parents=True, exist_ok=False)

    stats_file = run_dir / "server-stats.jsonl"
    server_log = run_dir / "server.log"
    client_warm = run_dir / "client-warmup.log"
    client_measured = run_dir / "client-measured.log"

    values: dict[str, Any] = {
        "port": port,
        "connections": config["connections"],
        "duration": config["measured_seconds"],
        "run_dir": str(run_dir.resolve()),
        "stats_file": str(stats_file.resolve()),
        "pid": 0,
        "message_size": config.get("message_size", 512),
    }

    server_cmd = render_args(config["server_cmd"], values)

    for flag in config.get("flags", []):
        server_cmd.append(str(flag))

    server_cmd = ensure_stats_file_argument(
        server_cmd,
        values["stats_file"],
    )

    result: dict[str, Any] = {
        "repeat": repeat,
        "port": port,
        "started_utc": utc_now(),
        "server_command": server_cmd,
        "server_pid": None,
        "warmup_exit": None,
        "measured_exit": None,
        "client_output_ok": None,
        "client_output_note": None,
        "acceptance_ok": None,
        "counter_delta": None,
        "messages_per_second": None,
        "accepted_run": False,
        "failure_reasons": [],
    }

    server: subprocess.Popen[bytes] | None = None
    measured: subprocess.Popen[bytes] | None = None
    measured_start: float | None = None
    measured_end: float | None = None
    before: dict[str, Any] | None = None
    after: dict[str, Any] | None = None

    try:
        with server_log.open("wb") as server_output:
            server = subprocess.Popen(
                server_cmd,
                stdout=server_output,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )

            values["pid"] = server.pid
            result["server_pid"] = server.pid

            wait_for_server_ready(
                server,
                port,
                float(config["server_ready_timeout"]),
            )

            result["server_ready"] = True
            result["server_ready_utc"] = utc_now()

            # Warm-up duration is distinct from measured duration.
            warmup_values = {
                **values,
                "duration": config["warmup_seconds"],
            }

            warm = run_command(
                config["warmup_cmd"],
                warmup_values,
                float(config["warmup_seconds"]) + 60.0,
                client_warm,
            )

            result["warmup_exit"] = warm.returncode

            if warm.returncode != 0:
                raise RuntimeError(
                    f"warm-up command failed ({warm.returncode}); "
                    f"see {client_warm}"
                )

            if server.poll() is not None:
                raise RuntimeError(
                    "server exited during warm-up "
                    f"(status {server.returncode})"
                )

            # Keep the established settling interval so warm-up activity
            # does not contaminate the measurement baseline.
            time.sleep(1.0)

            result["pre_run"] = snapshot(
                server,
                stats_file,
                config.get("cgroup_cpu_stat"),
                config.get("client_cpu_stat"),
                config.get("server_cpu"),
                config.get("interrupt_cpu"),
            )

            before = snapshot(
                server,
                stats_file,
                config.get("cgroup_cpu_stat"),
                config.get("client_cpu_stat"),
                config.get("server_cpu"),
                config.get("interrupt_cpu"),
            )

            result["before"] = before

            measured_argv = render_args(
                config["measured_cmd"],
                values,
            )

            if not measured_argv:
                raise ValueError("measured_cmd must not be empty")

            with client_measured.open("wb") as measured_output:
                measured_start = time.monotonic()

                measured = subprocess.Popen(
                    measured_argv,
                    stdout=measured_output,
                    stderr=subprocess.STDOUT,
                    start_new_session=True,
                )

                acceptance_ok = True

                if config.get("connections"):
                    accepted_before = int(
                        (
                            (before.get("server_stats") or {})
                            .get("stats", {})
                            .get("accepts", 0)
                        )
                    )

                    try:
                        result["accepted_snapshot"] = wait_for_accepts(
                            server,
                            stats_file,
                            int(config["connections"]),
                            accepted_before,
                            float(config["accept_timeout"]),
                        )

                    except (TimeoutError, RuntimeError) as exc:
                        acceptance_ok = False
                        result["acceptance_error"] = str(exc)
                        result["accepted_snapshot"] = None

                try:
                    measured.wait(
                        timeout=(
                            float(config["measured_seconds"])
                            + float(config["client_timeout_grace"])
                        )
                    )

                except subprocess.TimeoutExpired as exc:
                    stop_process(measured)

                    raise TimeoutError(
                        "measured client command exceeded its timeout"
                    ) from exc

                measured_end = time.monotonic()

            result["measured_exit"] = measured.returncode
            result["measured_elapsed_seconds"] = (
                measured_end - measured_start
            )

            result["acceptance_ok"] = acceptance_ok

            client_output_ok, client_output_note = validate_client_output(
                client_measured,
                config.get("client_validator"),
            )

            result["client_output_ok"] = client_output_ok
            result["client_output_note"] = client_output_note

            if measured.returncode != 0:
                raise RuntimeError(
                    f"measured client command failed "
                    f"({measured.returncode}); see {client_measured}"
                )

            if server.poll() is not None:
                raise RuntimeError(
                    "server exited during measurement "
                    f"(status {server.returncode})"
                )

            after = snapshot(
                server,
                stats_file,
                config.get("cgroup_cpu_stat"),
                config.get("client_cpu_stat"),
                config.get("server_cpu"),
                config.get("interrupt_cpu"),
            )

            result["after"] = after

            result["counter_delta"] = stats_delta(
                (before.get("server_stats") if before else None),
                after.get("server_stats"),
            )

            result["cgroup_cpu_delta_raw"] = [
                before.get("cgroup_cpu_stat") if before else None,
                after.get("cgroup_cpu_stat"),
            ]

            result["client_cpu_stat"] = [
                before.get("client_cpu_stat") if before else None,
                after.get("client_cpu_stat"),
            ]

            result["server_cpu_stat"] = [
                before.get("cpu_stat") if before else None,
                after.get("cpu_stat"),
            ]

            result["interrupt_cpu_stat"] = [
                before.get("interrupt_cpu_stat") if before else None,
                after.get("interrupt_cpu_stat"),
            ]

            delta = result["counter_delta"]
            elapsed = result["measured_elapsed_seconds"]

            if (
                isinstance(delta, dict)
                and isinstance(elapsed, (int, float))
                and elapsed > 0
                and isinstance(delta.get("messages"), int)
            ):
                result["messages_per_second"] = (
                    delta["messages"] / elapsed
                )

            accepted, reasons = automated_acceptance(
                result,
                config,
            )

            result["accepted_run"] = accepted
            result["failure_reasons"] = reasons

    except (
        OSError,
        ValueError,
        RuntimeError,
        TimeoutError,
        subprocess.SubprocessError,
    ) as exc:
        result["error"] = str(exc)
        result["failure_reasons"].append(str(exc))

        if measured is not None and measured.poll() is None:
            stop_process(measured)

        # Capture a final snapshot when possible so failed runs retain
        # as much evidence as possible.
        if server is not None and server.poll() is None:
            try:
                result["failure_snapshot"] = snapshot(
                    server,
                    stats_file,
                    config.get("cgroup_cpu_stat"),
                    config.get("client_cpu_stat"),
                    config.get("server_cpu"),
                    config.get("interrupt_cpu"),
                )
            except (OSError, RuntimeError, ValueError) as snapshot_error:
                result["snapshot_error"] = str(snapshot_error)

    finally:
        if measured is not None and measured.poll() is None:
            stop_process(measured)

        # Explicitly stop the server before recording its final status.
        if server is not None and server.poll() is None:
            stop_process(server, timeout=8.0)

        if server is not None:
            result["server_exit"] = server.poll()

        result["finished_utc"] = utc_now()

        # Persist evidence even when the repetition fails.
        (run_dir / "run.json").write_text(
            json.dumps(result, indent=2) + "\n"
        )

    return result


# ---------------------------------------------------------------------------
# Configuration loading and validation
# ---------------------------------------------------------------------------

def validate_config(config: dict[str, Any]) -> None:
    """Fail early on invalid experiment settings."""
    if int(config["repeats"]) < 5:
        raise ValueError("minimum repeats is five")

    for key in (
        "warmup_seconds",
        "measured_seconds",
        "cooldown_seconds",
        "server_ready_timeout",
        "accept_timeout",
        "client_timeout_grace",
    ):
        value = float(config[key])

        if value < 0:
            raise ValueError(f"{key} cannot be negative")

    if float(config["measured_seconds"]) <= 0:
        raise ValueError("measured_seconds must be greater than zero")

    if config.get("client_validator") not in (None, "wrk"):
        raise ValueError(
            f"unknown client_validator: {config['client_validator']}"
        )

    for key in ("server_cmd", "warmup_cmd", "measured_cmd"):
        command = config.get(key)

        if not isinstance(command, list):
            raise ValueError(
                f"{key} must be an array of command arguments"
            )

        if not command or not all(
            isinstance(part, (str, int, float))
            for part in command
        ):
            raise ValueError(
                f"{key} must be a nonempty array of strings/numbers"
            )

    if int(config["connections"]) < 0:
        raise ValueError("connections cannot be negative")

    if config.get("flags") is None:
        config["flags"] = []

    if not isinstance(config["flags"], list):
        raise ValueError("flags must be an array")


def load_config(path: pathlib.Path) -> dict[str, Any]:
    supplied = json.loads(path.read_text())

    if not isinstance(supplied, dict):
        raise ValueError(
            "configuration root must be a JSON object"
        )

    cells_raw = supplied.get("configurations")
    shared = {
        key: value
        for key, value in supplied.items()
        if key != "configurations"
    }

    base = DEFAULT_CONFIG | shared

    if cells_raw is None:
        cells = [DEFAULT_CONFIG | shared]

    else:
        if not isinstance(cells_raw, list) or not cells_raw:
            raise ValueError(
                "configurations must be a nonempty array "
                "of configuration objects"
            )

        cells = []

        for cell in cells_raw:
            if not isinstance(cell, dict):
                raise ValueError(
                    "each configurations entry must be a JSON object"
                )

            cells.append(DEFAULT_CONFIG | shared | cell)

    for cell in cells:
        validate_config(cell)

    if int(base["repeats"]) < 5:
        raise ValueError("minimum repeats is five")

    base["_cells"] = cells

    return base


# ---------------------------------------------------------------------------
# Campaign orchestration
# ---------------------------------------------------------------------------

def write_json(path: pathlib.Path, value: Any) -> None:
    path.write_text(
        json.dumps(value, indent=2) + "\n"
    )


def median_summary(
    run_records: list[dict[str, Any]],
) -> dict[str, Any]:
    """Summarize accepted repetitions only."""
    accepted_rates = [
        float(record["messages_per_second"])
        for record in run_records
        if record.get("accepted_run") is True
        and isinstance(
            record.get("messages_per_second"),
            (int, float),
        )
    ]

    rejected = sum(
        record.get("accepted_run") is False
        for record in run_records
    )

    unverified = sum(
        record.get("accepted_run") is None
        for record in run_records
    )

    summary: dict[str, Any] = {
        "total_runs": len(run_records),
        "accepted_runs": len(accepted_rates),
        "rejected_runs": rejected,
        "unverified_runs": unverified,
        "sufficient_accepted_runs": len(accepted_rates) >= 5,
    }

    if len(accepted_rates) < 5:
        summary["messages_per_second"] = None
        summary["message_rate_note"] = (
            "Insufficient accepted runs; at least five are required."
        )
        return summary

    ordered = sorted(accepted_rates)

    median = statistics.median(ordered)
    lower = ordered[:len(ordered) // 2]
    upper = ordered[(len(ordered) + 1) // 2:]

    q1 = statistics.median(lower)
    q3 = statistics.median(upper)

    summary["messages_per_second"] = {
        "median": median,
        "iqr": q3 - q1,
        "minimum": min(ordered),
        "maximum": max(ordered),
        "runs": ordered,
    }

    return summary


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__
    )

    parser.add_argument(
        "config",
        type=pathlib.Path,
        help="JSON run configuration",
    )

    parser.add_argument(
        "--repeats",
        type=int,
        help="override repeats; minimum five",
    )

    parser.add_argument(
        "--seed",
        type=int,
        default=20261102,
        help="seed for reproducible randomized order",
    )

    args = parser.parse_args()

    try:
        config = load_config(args.config)

        if args.repeats is not None:
            if args.repeats < 5:
                raise ValueError("minimum repeats is five")

            config["repeats"] = args.repeats

        cells = config.pop("_cells")

        # Validate again after applying any CLI overrides.
        for cell in cells:
            validate_config(cell)

        labels = [
            config_label(cell)
            for cell in cells
        ]

        if len(labels) != len(set(labels)):
            duplicates = sorted(
                {
                    name
                    for name in labels
                    if labels.count(name) > 1
                }
            )

            raise ValueError(
                "configuration labels are not unique: "
                + ", ".join(duplicates)
            )

        root = pathlib.Path(
            config["run_root"]
        ).resolve()

        stamp = dt.datetime.now().strftime(
            "%Y%m%d-%H%M%S"
        )

        label = safe_component(
            str(config.get("workload", "campaign"))
        )

        session = root / f"{label}-{stamp}"
        session.mkdir(parents=True, exist_ok=False)

        write_json(
            session / "config.json",
            {
                **config,
                "configurations": cells,
                "random_seed": args.seed,
            },
        )

        write_json(
            session / "environment.json",
            environment(config),
        )

        results: dict[str, list[dict[str, Any]]] = {
            name: []
            for name in labels
        }

        rng = random.Random(args.seed)

        order = list(
            range(1, int(config["repeats"]) + 1)
        )

        rng.shuffle(order)

        run_index = 0
        total_runs = len(cells) * len(order)

        for repeat in order:
            block = list(range(len(cells)))
            rng.shuffle(block)

            for cell_index in block:
                cell = cells[cell_index]
                cell_name = config_label(cell)

                port = int(cell.get("port", 0))

                if port == 0:
                    # Reserve a free port briefly, then release it.
                    # The server binds it later; this does not guarantee
                    # immunity from another process racing for the port.
                    with socket.socket() as reservation:
                        reservation.bind(
                            ("127.0.0.1", 0)
                        )
                        port = reservation.getsockname()[1]

                run_dir = (
                    session
                    / f"{cell_name}-run{repeat}"
                )

                print(
                    f"[{run_index + 1}/{total_runs}] "
                    f"{cell_name}, repetition {repeat}, port {port}",
                    flush=True,
                )

                try:
                    result = execute_repeat(
                        cell,
                        repeat,
                        run_dir,
                        port,
                    )

                except (
                    OSError,
                    ValueError,
                    RuntimeError,
                    TimeoutError,
                    subprocess.SubprocessError,
                ) as exc:
                    # execute_repeat normally records its own failures.
                    # This guard preserves campaign progress if setup
                    # fails before its per-run record can be produced.
                    run_dir.mkdir(
                        parents=True,
                        exist_ok=True,
                    )

                    result = {
                        "repeat": repeat,
                        "port": port,
                        "started_utc": utc_now(),
                        "finished_utc": utc_now(),
                        "accepted_run": False,
                        "messages_per_second": None,
                        "error": str(exc),
                        "failure_reasons": [str(exc)],
                    }

                    write_json(
                        run_dir / "run.json",
                        result,
                    )

                results[cell_name].append(result)
                run_index += 1

                if result.get("accepted_run") is True:
                    print(
                        f"  ACCEPT: "
                        f"{result.get('messages_per_second')} "
                        "messages/s",
                        flush=True,
                    )
                else:
                    print(
                        f"  REJECT: "
                        f"{result.get('failure_reasons', [])}",
                        file=sys.stderr,
                        flush=True,
                    )

                if run_index < total_runs:
                    cooldown = float(
                        cell["cooldown_seconds"]
                    )

                    if cooldown > 0:
                        time.sleep(cooldown)

        summary_cells: dict[str, Any] = {}

        for cell_name, cell_results in results.items():
            summary_cells[cell_name] = median_summary(
                cell_results
            )

        all_accepted = all(
            record.get("accepted_run") is True
            for group in results.values()
            for record in group
        )

        enough_valid_runs = all(
            len(
                [
                    record
                    for record in group
                    if record.get("accepted_run") is True
                    and isinstance(
                        record.get("messages_per_second"),
                        (int, float),
                    )
                ]
            ) >= 5
            for group in results.values()
        )

        write_json(
            session / "summary.json",
            {
                "session": str(session),
                "random_seed": args.seed,
                "cells": summary_cells,
                "all_runs_accepted": all_accepted,
                "enough_valid_runs_for_every_cell": enough_valid_runs,
                "note": (
                    "Automated acceptance is not a substitute for "
                    "reviewing raw logs, setup-dependent checks, "
                    "and the experiment plan."
                ),
            },
        )

        print()
        print(f"Results saved to: {session}")

        if not all_accepted or not enough_valid_runs:
            print(
                "CAMPAIGN INCOMPLETE: inspect rejected runs and logs.",
                file=sys.stderr,
            )
            return 2

        print(
            "CAMPAIGN COMPLETE: all runs passed automated checks "
            "and each cell has at least five accepted repetitions."
        )

        return 0

    except (
        OSError,
        ValueError,
        RuntimeError,
        TimeoutError,
        json.JSONDecodeError,
        subprocess.SubprocessError,
    ) as exc:
        print(
            f"run_experiment: {exc}",
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())