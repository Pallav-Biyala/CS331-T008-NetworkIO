{
  "_comment": [
    "E5b compares one TCP connection per response (wrk sends Connection: close) with sequential keep-alive reuse.",
    "Fixed controls: 4 KiB file, 100 configured simultaneous connections, 4 wrk threads, 10 s warm-up, 30 s measurement, 5 repetitions.",
    "wrk is duration-based, so completed request totals can differ; report requests/s, bytes/s, accept counts and latency rather than claiming equal request totals.",
    "Expected: 8 configurations, 40 runs. The client mode is implemented by the actual HTTP header in each command."
  ],
  "server": "filesrv",
  "workload": "e5b-connection-reuse-c300",
  "message_size": null,
  "warmup_seconds": 10,
  "measured_seconds": 30,
  "cooldown_seconds": 10,
  "repeats": 5,
  "server_cpu": 1,
  "client_validator": "wrk",
  "run_root": "results",
  "server_ready_timeout": 10,
  "accept_timeout": 60,
  "client_timeout_grace": 60,
  "file": "bench-4KiB.bin",
  "connections": 100,
  "client_threads": 4,
  "configurations": [
    {
      "mechanism": "select",
      "workload": "e5b-close-per-response",
      "warmup_cmd": [
        "taskset",
        "-c",
        "2-5",
        "wrk",
        "-t{threads}",
        "-c{connections}",
        "-d{duration}s",
        "--timeout",
        "120s",
        "-H",
        "Connection: close",
        "http://127.0.0.1:{port}/{file}"
      ],
      "measured_cmd": [
        "taskset",
        "-c",
        "2-5",
        "wrk",
        "-t{threads}",
        "-c{connections}",
        "-d{duration}s",
        "--timeout",
        "120s",
        "-H",
        "Connection: close",
        "--latency",
        "-s",
        "code/tools/File-Transfer-Server/wrk_report.lua",
        "http://127.0.0.1:{port}/{file}"
      ],
      "server_cmd": [
        "./build/filesrv-select",
        "--port",
        "{port}",
        "--cpu",
        "1",
        "--max-conns",
        "300"
      ],
      "_comment": "Connection: close",
      "connection_check": "accepts"
    },
