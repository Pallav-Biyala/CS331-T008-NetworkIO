{
  "_comment": [
    "Reduced E7 screening matrix uses a 4 MiB file and 100 connections; all four selected settings run on every mechanism.",
    "All cells hold --buf-size=256 KiB. Baseline means 64 KiB chunk with default socket buffers at this fixed application buffer.",
    "Selected settings: baseline, chunk-size=16 KiB, SO_RCVBUF=512 KiB, and SO_SNDBUF=64 KiB. This is a screening comparison, not a full sensitivity curve.",
    "Expected: 4 settings x 4 mechanisms = 16 configurations, 80 runs. Linux may report doubled socket-buffer values; stats record requested settings."
  ],
  "server": "filesrv",
  "workload": "e7-buffer-sensitivity",
  "message_size": null,
  "warmup_seconds": 10,
  "measured_seconds": 30,
  "cooldown_seconds": 10,
  "repeats": 5,
  "server_cpu": 1,
  "client_validator": "wrk",
  "run_root": "results",
  "server_ready_timeout": 10,
  "accept_timeout": 60,
  "client_timeout_grace": 60,
  "file": "bench-4MiB.bin",
  "connections": 100,
  "client_threads": 4,
