{
  "_comment": [
    "E9 tests 4 KiB and 64 KiB files at 100 connections, comparing --nodelay=1 and --nodelay=0.",
    "The only changed server option is TCP_NODELAY. core_setup_accepted applies it with setsockopt to every accepted socket; server stats record the effective configured boolean.",
    "client_threads=4 divides 100 connections evenly. Expected: 2 sizes x 2 option values x 4 mechanisms = 16 configurations, 80 runs."
  ],
  "server": "filesrv",
  "workload": "e9-tcp-nodelay",
  "message_size": null,
  "warmup_seconds": 10,
  "measured_seconds": 30,
  "cooldown_seconds": 10,
  "repeats": 5,
  "server_cpu": 1,
  "client_validator": "wrk",
  "run_root": "results",
  "server_ready_timeout": 10,
  "accept_timeout": 60,
  "client_timeout_grace": 60,
  "connections": 100,
  "client_threads": 4,
  "configurations": [
    {
      "mechanism": "select",
      "workload": "e9-nodelay1",
      "file": "bench-4KiB.bin",
      "warmup_cmd": [
        "taskset",
        "-c",
        "2-5",
        "wrk",
        "-t{threads}",
        "-c{connections}",
        "-d{duration}s",
        "--timeout",
        "120s",
        "http://127.0.0.1:{port}/{file}"
      ],
      "measured_cmd": [
        "taskset",
        "-c",
        "2-5",
        "wrk",
        "-t{threads}",
        "-c{connections}",
        "-d{duration}s",
        "--timeout",
        "120s",
        "--latency",
        "-s",
        "code/tools/File-Transfer-Server/wrk_report.lua",
        "http://127.0.0.1:{port}/{file}"
      ],
      "server_cmd": [
        "./build/filesrv-select",
        "--port",
        "{port}",
        "--cpu",
        "1",
        "--max-conns",
        "100",
        "--nodelay=1"
