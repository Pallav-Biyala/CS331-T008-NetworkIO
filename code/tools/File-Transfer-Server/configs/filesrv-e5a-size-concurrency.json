        "-t{threads}",
        "-c{connections}",
        "-d{duration}s",
        "--timeout",
        "120s",
        "--latency",
        "-s",
        "code/tools/File-Transfer-Server/wrk_report.lua",
        "http://127.0.0.1:{port}/{file}"
      ],
      "server_cmd": [
        "./build/filesrv-uring",
        "--port",
        "{port}",
        "--cpu",
        "1",
        "--max-conns",
        "100"
      ],
      "_comment": "1048576 bytes; wrk -t4 -c100. Select at 1000 is subject to FD_SETSIZE and must pass runner acceptance to count."
    }
  ]
}
