{
  "_comment": [
    "Diagnostic retry of only the four E5b close-per-response cells after the initial runs were rejected.",
    "Uses the unchanged 4 KiB file, 100 wrk connections, 4 threads, timing, validator, and five repetitions.",
    "Server --max-conns=300 is applied uniformly across select, poll, epoll, and io_uring.",
    "Diagnostic only: compare with keep-alive only after rerunning keep-alive under the same --max-conns setting.",
    "Expected: 4 configurations x 5 repetitions = 20 runs. No original result directory is reused."
  ],
  "server": "filesrv",
  "workload": "e5b-close-retry-c300",
  "message_size": null,
  "warmup_seconds": 10,
  "measured_seconds": 30,
  "cooldown_seconds": 10,
  "repeats": 5,
  "server_cpu": 1,
  "client_validator": "wrk",
  "run_root": "results",
  "server_ready_timeout": 10,
  "accept_timeout": 60,
  "client_timeout_grace": 60,
  "file": "bench-4KiB.bin",
  "connections": 100,
  "client_threads": 4,
  "configurations": [
    {
      "mechanism": "select",
      "workload": "e5b-close-per-response",
      "warmup_cmd": [
        "taskset",
        "-c",
        "2-5",
        "wrk",
        "-t{threads}",
        "-c{connections}",
        "-d{duration}s",
        "--timeout",
        "120s",
        "-H",
        "Connection: close",
        "http://127.0.0.1:{port}/{file}"
      ],
      "measured_cmd": [
        "taskset",
        "-c",
        "2-5",
        "wrk",
        "-t{threads}",
        "-c{connections}",
        "-d{duration}s",
        "--timeout",
        "120s",
        "-H",
        "Connection: close",
        "--latency",
        "-s",
        "code/tools/File-Transfer-Server/wrk_report.lua",
        "http://127.0.0.1:{port}/{file}"
      ],
      "server_cmd": [
        "./build/filesrv-select",
        "--port",
        "{port}",
        "--cpu",
        "1",
        "--max-conns",
        "300"
      ],
      "_comment": "Connection: close",
