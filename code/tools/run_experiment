#!/usr/bin/env python3
"""Run one repeatable Linux benchmark configuration and archive its evidence.

Assumptions / unresolved setup:
- The plan refers to a run-configuration format, but the checkout defines none.
  This script defines a JSON format: server_cmd, warmup_cmd and measured_cmd are
  argument arrays; {port}, {connections}, {duration}, {run_dir}, {stats_file}
  and {pid} are substituted. Workload commands must return a nonzero status on
  client errors. Give a top-level configurations array to run a randomized
  block of mechanisms/flags for each workload point; each cell inherits shared
  top-level settings and overrides them as needed.
- The runner performs one fresh server process per run, a 10 s warm-up, then a
  timed measured invocation and signal snapshots. It defaults to 7 repeats,
  10 s warm-up, 30 s measurement and 10 s cooldown; override only after the
  pilot has established setup-specific values.
- The plan requires a dedicated cgroup, client/server machine tuning, frequency
  and temperature checks, interrupt-core snapshots and kernel-warning checks.
  These depend on section 14 setup data. This runner captures available host
  state and optional cgroup/proc paths; it does not tune the machine or claim
  unavailable measurements.
- To snapshot stats through SIGUSR1, server_cmd must include the project's
  --stats-file option pointing to {stats_file}; the JSON stream's last record
  is used. Workload commands should run for the duration passed in {duration}.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import pathlib
import platform
import random
import shlex
import signal
import statistics
import subprocess
import sys
import time
from typing import Any


DEFAULT_CONFIG = {
    "server": "echo",
    "mechanism": "epoll",
    "flags": [],
    "workload": "manual",
    "connections": 100,
    "message_size": 512,
    "offered_rate": None,
    "delay": "none",
    "server_cmd": [],
    "warmup_cmd": [],
    "measured_cmd": [],
    "warmup_seconds": 10,
    "measured_seconds": 30,
    "cooldown_seconds": 10,
    "repeats": 7,
    "server_cpu": None,
    "interrupt_cpu": None,
    "cgroup_cpu_stat": None,
    "client_cpu_stat": None,
    "run_root": "results",
}


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def read_json_lines(path: pathlib.Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    records = []
    for line in path.read_text(errors="replace").splitlines():
        try:
            value = json.loads(line)
            if isinstance(value, dict):
                records.append(value)
        except json.JSONDecodeError:
            continue
    return records


def latest_stats(path: pathlib.Path) -> dict[str, Any] | None:
    records = read_json_lines(path)
    return records[-1] if records else None


def stats_delta(before: dict[str, Any] | None, after: dict[str, Any] | None) -> dict[str, int] | None:
    if before is None or after is None:
        return None
    b = before.get("stats", {})
    a = after.get("stats", {})
    return {key: int(a[key]) - int(b.get(key, 0)) for key in a if isinstance(a[key], (int, float))}


def read_text(path: str | pathlib.Path) -> str | None:
    try:
        return pathlib.Path(path).read_text(errors="replace")
    except OSError:
        return None


def environment(config: dict[str, Any]) -> dict[str, Any]:
    env: dict[str, Any] = {
        "captured_utc": utc_now(),
        "kernel": platform.release(),
        "platform": platform.platform(),
        "python": sys.version,
        "cpuinfo": read_text("/proc/cpuinfo"),
        "meminfo": read_text("/proc/meminfo"),
        "sysctls": {},
        "limits": {},
        "cgroup_cpu_stat": None,
        "server_cpu_stat": None,
        "interrupt_cpu_stat": None,
        "cpu_governor": None,
        "unavailable": [],
    }
    for key in ("kernel.io_uring_disabled", "kernel.perf_event_paranoid",
                "net.core.somaxconn", "net.ipv4.ip_local_port_range", "net.ipv4.tcp_tw_reuse"):
        proc = pathlib.Path("/proc/sys") / pathlib.Path(key.replace(".", "/"))
        val = read_text(proc)
        env["sysctls"][key] = val.strip() if val is not None else None
    try:
        env["limits"]["nofile"] = list(__import__("resource").getrlimit(__import__("resource").RLIMIT_NOFILE))
        env["limits"]["memlock"] = list(__import__("resource").getrlimit(__import__("resource").RLIMIT_MEMLOCK))
    except (ImportError, OSError, ValueError):
        env["unavailable"].append("process resource limits")
    if config.get("cgroup_cpu_stat"):
        env["cgroup_cpu_stat"] = read_text(config["cgroup_cpu_stat"])
    if config.get("client_cpu_stat"):
        env["client_cpu_stat"] = read_text(config["client_cpu_stat"])
    if config.get("server_cpu") is not None:
        env["server_cpu_stat"] = cpu_stat(int(config["server_cpu"]))
    if config.get("interrupt_cpu") is not None:
        env["interrupt_cpu_stat"] = cpu_stat(int(config["interrupt_cpu"]))
    if config.get("server_cpu") is not None:
        env["cpu_governor"] = read_text(
            f"/sys/devices/system/cpu/cpu{int(config['server_cpu'])}/cpufreq/scaling_governor"
        )
    commands = ["uname -a", "lscpu", "ip -br link",
                "sysctl kernel.io_uring_disabled kernel.perf_event_paranoid net.core.somaxconn "
                "net.ipv4.ip_local_port_range net.ipv4.tcp_tw_reuse"]
    if config.get("nic_interface"):
        interface = str(config["nic_interface"])
        commands.extend((f"ethtool {interface}", f"ethtool -k {interface}", f"ethtool -c {interface}"))
    for command in commands:
        try:
            result = subprocess.run(shlex.split(command), capture_output=True, text=True, timeout=10)
            env.setdefault("host_commands", {})[command] = result.stdout if result.returncode == 0 else result.stderr
        except (OSError, subprocess.SubprocessError):
            env.setdefault("host_commands", {})[command] = "unavailable"
    try:
        env["git_commit"] = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True,
                                         text=True, check=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        env["git_commit"] = None
        env["unavailable"].append("git commit hash")
    return env


def cpu_stat(cpu: int) -> str | None:
    data = read_text("/proc/stat")
    if data is None:
        return None
    label = f"cpu{cpu} "
    return next((line for line in data.splitlines() if line.startswith(label)), None)


def host_health(config: dict[str, Any]) -> dict[str, Any]:
    cpus = []
    for key in ("server_cpu", "interrupt_cpu"):
        value = config.get(key)
        if value is not None and int(value) not in cpus:
            cpus.append(int(value))
    frequencies = {}
    for cpu in cpus:
        frequencies[str(cpu)] = read_text(
            f"/sys/devices/system/cpu/cpu{cpu}/cpufreq/scaling_cur_freq"
        )
    thermal = {}
    for path in pathlib.Path("/sys/class/thermal").glob("thermal_zone*/temp"):
        thermal[str(path)] = read_text(path)
    return {"cpu_frequency_khz": frequencies, "thermal_zone_values": thermal}


def render_args(command: list[str], values: dict[str, Any]) -> list[str]:
    return [str(part).format_map(values) for part in command]


def run_command(command: list[str], values: dict[str, Any], timeout: float | None,
                output_path: pathlib.Path) -> subprocess.CompletedProcess[bytes]:
    argv = render_args(command, values)
    if not argv:
        raise ValueError("command arrays must not be empty")
    with output_path.open("wb") as out:
        return subprocess.run(argv, stdout=out, stderr=subprocess.STDOUT,
                              timeout=timeout, check=False)


def wait_for_accepts(server: subprocess.Popen[bytes], stats_path: pathlib.Path,
                     connections: int, accepted_before: int = 0,
                     timeout: float = 60.0) -> dict[str, Any] | None:
    deadline = time.monotonic() + timeout
    latest = None
    while time.monotonic() < deadline:
        if server.poll() is not None:
            raise RuntimeError(f"server exited while waiting for clients (status {server.returncode})")
        try:
            server.send_signal(signal.SIGUSR1)
        except ProcessLookupError as exc:
            raise RuntimeError("server exited while waiting for client acceptance") from exc
        time.sleep(0.2)
        latest = latest_stats(stats_path)
        if latest and int(latest.get("stats", {}).get("accepts", 0)) >= accepted_before + connections:
            return latest
    raise TimeoutError(f"server did not accept {connections} clients within {timeout:g}s")


def snapshot(server: subprocess.Popen[bytes], stats_path: pathlib.Path,
             cpu_file: str | None, client_cpu_file: str | None,
             cpu: int | None,
             interrupt_cpu: int | None) -> dict[str, Any]:
    try:
        server.send_signal(signal.SIGUSR1)
    except ProcessLookupError:
        pass
    time.sleep(0.25)
    return {
        "captured_utc": utc_now(),
        "server_stats": latest_stats(stats_path),
        "cgroup_cpu_stat": read_text(cpu_file) if cpu_file else None,
        "client_cpu_stat": read_text(client_cpu_file) if client_cpu_file else None,
        "cpu_stat": cpu_stat(int(cpu)) if cpu is not None else None,
        "interrupt_cpu_stat": cpu_stat(int(interrupt_cpu)) if interrupt_cpu is not None else None,
        "health": host_health({"server_cpu": cpu, "interrupt_cpu": interrupt_cpu}),
    }


def safe_component(text: str) -> str:
    return "".join(ch if ch.isalnum() or ch in "._-" else "_" for ch in text) or "run"


def config_label(config: dict[str, Any]) -> str:
    flags = "baseline" if not config.get("flags") else "_".join(map(str, config["flags"]))
    return "-".join(safe_component(str(value)) for value in
                    (config.get("server", ""), config.get("mechanism", ""), flags,
                     config.get("workload", "")))


def median_summary(run_records: list[dict[str, Any]]) -> dict[str, Any]:
    values = [r.get("messages_per_second") for r in run_records if isinstance(r.get("messages_per_second"), (int, float))]
    if not values:
        return {"messages_per_second": None, "message_rate_note": "client output not parsed; see raw client logs"}
    ordered = sorted(values)
    median = statistics.median(ordered)
    q1 = statistics.median(ordered[: len(ordered) // 2])
    q3 = statistics.median(ordered[(len(ordered) + 1) // 2 :])
    return {"messages_per_second": {"median": median, "iqr": q3 - q1,
                                     "minimum": min(ordered), "maximum": max(ordered),
                                     "runs": ordered}}


def execute_repeat(config: dict[str, Any], repeat: int, run_dir: pathlib.Path,
                   port: int) -> dict[str, Any]:
    run_dir.mkdir(parents=True, exist_ok=False)
    stats_file = run_dir / "server-stats.jsonl"
    values = {"port": port, "connections": config["connections"],
              "duration": config["measured_seconds"], "run_dir": str(run_dir.resolve()),
              "stats_file": str(stats_file.resolve()), "pid": 0,
              "message_size": config.get("message_size", 512)}
    server_cmd = render_args(config["server_cmd"], values)
    for arg in config.get("flags", []):
        server_cmd.append(str(arg))
    if not any(arg == "--stats-file" or arg.startswith("--stats-file=") for arg in server_cmd):
        server_cmd.extend(("--stats-file", values["stats_file"]))
    server_log = run_dir / "server.log"
    client_warm = run_dir / "client-warmup.log"
    client_measured = run_dir / "client-measured.log"
    result: dict[str, Any] = {"repeat": repeat, "started_utc": utc_now(), "server_command": server_cmd}
    with server_log.open("wb") as log:
        server = subprocess.Popen(server_cmd, stdout=log, stderr=subprocess.STDOUT,
                                  start_new_session=True)
        values["pid"] = server.pid
        result["server_pid"] = server.pid
        try:
            warm = run_command(config["warmup_cmd"], values,
                               float(config["warmup_seconds"]) + 60.0, client_warm)
            result["warmup_exit"] = warm.returncode
            if warm.returncode != 0:
                raise RuntimeError(f"warm-up command failed ({warm.returncode}); see {client_warm}")
            time.sleep(1.0)  # allow warm-up connections to close before baseline
            pre_run = snapshot(server, stats_file, config.get("cgroup_cpu_stat"),
                               config.get("client_cpu_stat"),
                               config.get("server_cpu"), config.get("interrupt_cpu"))
            result["pre_run"] = pre_run
            measured_argv = render_args(config["measured_cmd"], values)
            with client_measured.open("wb") as measured_log:
                measured = subprocess.Popen(measured_argv, stdout=measured_log,
                                            stderr=subprocess.STDOUT, start_new_session=True)
                if config.get("connections"):
                    accepted_before = int((pre_run.get("server_stats") or {}).get("stats", {}).get("accepts", 0))
                    result["accepted_snapshot"] = wait_for_accepts(
                        server, stats_file, int(config["connections"]), accepted_before
                    )
                before = snapshot(server, stats_file, config.get("cgroup_cpu_stat"),
                                  config.get("client_cpu_stat"),
                                  config.get("server_cpu"), config.get("interrupt_cpu"))
                result["before"] = before
                measured_start = time.monotonic()
                try:
                    measured.wait(timeout=float(config["measured_seconds"]) + 60.0)
                except subprocess.TimeoutExpired:
                    measured.terminate()
                    try:
                        measured.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        measured.kill()
                        measured.wait(timeout=5)
                    raise TimeoutError("measured client command exceeded its timeout")
            elapsed = time.monotonic() - measured_start
            result["measured_exit"] = measured.returncode
            result["measured_elapsed_seconds"] = elapsed
            if measured.returncode != 0:
                raise RuntimeError(f"measured client command failed ({measured.returncode}); see {client_measured}")
            after = snapshot(server, stats_file, config.get("cgroup_cpu_stat"),
                             config.get("client_cpu_stat"),
                             config.get("server_cpu"), config.get("interrupt_cpu"))
            result["after"] = after
            result["counter_delta"] = stats_delta(before.get("server_stats"), after.get("server_stats"))
            result["cgroup_cpu_delta_raw"] = [before.get("cgroup_cpu_stat"), after.get("cgroup_cpu_stat")]
            result["client_cpu_stat"] = [before.get("client_cpu_stat"), after.get("client_cpu_stat")]
            result["server_cpu_stat"] = [before.get("cpu_stat"), after.get("cpu_stat")]
            result["interrupt_cpu_stat"] = [before.get("interrupt_cpu_stat"), after.get("interrupt_cpu_stat")]
            result["messages_per_second"] = None
            result["accepted_run"] = None
            result["acceptance_note"] = "review section 12.4 setup-dependent checks and raw logs before accepting"
            if result["counter_delta"]:
                delta = result["counter_delta"]
                result["accepted_run"] = (
                    delta.get("errors", 0) == 0 and delta.get("ring_overflows", 0) == 0
                    and measured.returncode == 0
                )
                result["messages_per_second"] = delta.get("messages", 0) / max(elapsed, 0.001)
                if delta.get("peer_resets", 0) > int(config.get("connections", 0)):
                    result["accepted_run"] = False
            else:
                result["acceptance_note"] = "stats snapshots unavailable; review run manually"
        finally:
            if server.poll() is None:
                server.send_signal(signal.SIGTERM)
                try:
                    server.wait(timeout=8)
                except subprocess.TimeoutExpired:
                    server.kill()
                    server.wait(timeout=5)
        result["server_exit"] = server.returncode
        result["finished_utc"] = utc_now()
    (run_dir / "run.json").write_text(json.dumps(result, indent=2) + "\n")
    return result


def load_config(path: pathlib.Path) -> dict[str, Any]:
    supplied = json.loads(path.read_text())
    if not isinstance(supplied, dict):
        raise ValueError("configuration root must be a JSON object")
    base = DEFAULT_CONFIG | supplied
    cells_raw = supplied.get("configurations")
    cells = [DEFAULT_CONFIG | {k: v for k, v in supplied.items() if k != "configurations"}]
    if cells_raw is not None:
        if not isinstance(cells_raw, list) or not cells_raw:
            raise ValueError("configurations must be a nonempty array of configuration objects")
        shared = {k: v for k, v in supplied.items() if k != "configurations"}
        cells = []
        for cell in cells_raw:
            if not isinstance(cell, dict):
                raise ValueError("each configurations entry must be a JSON object")
            cells.append(DEFAULT_CONFIG | shared | cell)
    for cfg in cells:
        for key in ("server_cmd", "warmup_cmd", "measured_cmd"):
            if not isinstance(cfg[key], list) or not all(isinstance(x, (str, int, float)) for x in cfg[key]):
                raise ValueError(f"{key} must be an array of argument strings")
        if not cfg["server_cmd"] or not cfg["warmup_cmd"] or not cfg["measured_cmd"]:
            raise ValueError("server_cmd, warmup_cmd and measured_cmd are required for every cell")
    if int(base["repeats"]) < 5:
        raise ValueError("section 12.2 requires at least five repeats")
    base["_cells"] = cells
    return base


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("config", type=pathlib.Path, help="JSON run configuration")
    parser.add_argument("--repeats", type=int, help="override repeats (minimum five)")
    parser.add_argument("--seed", type=int, default=20261102, help="seed for randomized mechanism order")
    args = parser.parse_args()
    try:
        config = load_config(args.config)
        if args.repeats is not None:
            if args.repeats < 5:
                raise ValueError("minimum repeats is five")
            config["repeats"] = args.repeats
        cells = config.pop("_cells")
        root = pathlib.Path(config["run_root"]).resolve()
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        label = safe_component(str(config.get("workload", "campaign")))
        session = root / f"{label}-{stamp}"
        session.mkdir(parents=True, exist_ok=False)
        (session / "config.json").write_text(json.dumps({**config, "configurations": cells}, indent=2) + "\n")
        (session / "environment.json").write_text(json.dumps(environment(config), indent=2) + "\n")
        results: dict[str, list[dict[str, Any]]] = {config_label(cell): [] for cell in cells}
        rng = random.Random(args.seed)
        order = list(range(1, int(config["repeats"]) + 1))
        rng.shuffle(order)
        run_index = 0
        total_runs = len(cells) * len(order)
        for repeat in order:
            block = list(range(len(cells)))
            rng.shuffle(block)
            for cell_index in block:
                cell = cells[cell_index]
                cell_name = config_label(cell)
                port = int(cell.get("port", 0))
                if port == 0:
                    import socket
                    with socket.socket() as reservation:
                        reservation.bind(("127.0.0.1", 0))
                        port = reservation.getsockname()[1]
                run_dir = session / f"{cell_name}-run{repeat}"
                result = execute_repeat(cell, repeat, run_dir, port)
                results[cell_name].append(result)
                run_index += 1
                if result.get("accepted_run") is False:
                    print(f"REJECT {cell_name} run {repeat}: section 12.4 acceptance criteria failed", file=sys.stderr)
                if run_index < total_runs:
                    time.sleep(float(cell["cooldown_seconds"]))
        summary_cells = {}
        for cell_name, cell_results in results.items():
            summary_cells[cell_name] = {
                **median_summary(cell_results), "runs": len(cell_results),
                "accepted_runs": sum(r.get("accepted_run") is True for r in cell_results),
                "rejected_or_unverified_runs": sum(r.get("accepted_run") is not True for r in cell_results),
            }
        (session / "summary.json").write_text(json.dumps({
            "session": str(session), "cells": summary_cells,
            "note": "review each run's raw client logs and section 12.4 setup-dependent checks",
        }, indent=2) + "\n")
        print(session)
        return 0 if all(r.get("accepted_run") is True for group in results.values() for r in group) else 2
    except (OSError, ValueError, RuntimeError, TimeoutError, json.JSONDecodeError,
            subprocess.SubprocessError) as exc:
        print(f"run_experiment: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
